# Your Jira Cloud site, no trailing slash.
JIRA_BASE_URL=https://yourcompany.atlassian.net

# The Atlassian account the app authenticates as.
JIRA_EMAIL=you@yourcompany.com

# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# Optional: port for the local dashboard (default 5123).
PORT=5123

# Optional. Lets the board show the state of PRs linked in a ticket description
# (open / merged / declined), lifts GitHub's rate limit, and reaches private
# repos. Create at https://github.com/settings/tokens with "repo" scope.
# GITHUB_TOKEN=
